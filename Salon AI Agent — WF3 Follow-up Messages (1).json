    {
      "parameters": {
        "jsCode": "const today = new Date().toLocaleDateString('en-CA', { timeZone: 'Africa/Douala' });\nconst toDay = (v) => {\n  const m = String(v || '').trim().match(/(\\d{4})-(\\d{2})-(\\d{2})/);\n  return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) / 86400000 : null;\n};\nconst t = toDay(today);\nconst yes = (v) => String(v || '').trim().toLowerCase() === 'yes';\nreturn $input.all()\n  .filter((i) => i.json.Email && i.json['Booking Status'] !== 'Cancelled')\n  .map((i) => {\n    const r = i.json;\n    const appt = toDay(r['Appointment Date']);\n    const booked = toDay(r['Booking Date']);\n    let stage = 'none';\n    if (appt !== null && t > appt && !yes(r['Post-Service Sent'])) stage = 'postservice';\n    else if (appt !== null && booked !== null && t <= appt && t - booked >= 3 && yes(r['Follow-up 1 Sent']) && !yes(r['Follow-up 2 Sent'])) stage = 'followup2';\n    else if (booked !== null && t - booked >= 1 && t <= (appt === null ? t : appt) && !yes(r['Follow-up 1 Sent'])) stage = 'followup1';\n    return { json: { ...r, stage } };\n  });"
      },
